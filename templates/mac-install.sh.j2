#!/bin/bash
# Generated by Ansible on the u26 (mac-link). Stock-macOS installer: no sudo, no
# Homebrew, no Python. Safe to re-run; it only rewrites what changed.
# Contains private keys for the Mac side of the link -- don't share it.
set -eu

[ "$(uname)" = Darwin ] || { echo "run this on the Mac" >&2; exit 1; }

ME=$(id -un)
if [ "$ME" != "{{ mac_user }}" ]; then
  echo "This installer was built for Mac user '{{ mac_user }}' but you are '$ME'." >&2
  echo "Set mac_user: $ME in group_vars/all.yml on the u26 and re-run u26.yml." >&2
  exit 1
fi

D="$HOME/{{ mac_link_dirname }}"
mkdir -p "$D"
chmod 700 "$D"
CHANGED=""

# put FILE MODE < content: replace FILE only when the content differs
put() {
  local tmp
  tmp=$(mktemp "$D/.tmp.XXXXXX")
  cat >"$tmp"
  chmod "$2" "$tmp"
  if cmp -s "$tmp" "$1"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$1"
    CHANGED="$CHANGED $(basename "$1")"
  fi
}
changed() { case " $CHANGED " in *" $1 "*) return 0 ;; esac; return 1; }

put "$D/ssh_host_ed25519_key" 600 <<'KEY'
{{ lookup('file', mac_keys_dir ~ '/ssh_host_ed25519_key') }}
KEY

put "$D/tunnel_key" 600 <<'KEY'
{{ lookup('file', mac_keys_dir ~ '/tunnel_key') }}
KEY

# Only connections arriving through the tunnel (loopback) may use the u26 key.
put "$D/authorized_keys" 600 <<'EOF'
from="127.0.0.1,::1" {{ u26_user_pubkey }}
EOF

put "$D/known_hosts" 600 <<'EOF'
u26 {{ u26_hostkey }}
EOF

put "$D/sshd_config" 600 <<EOF
# User-level sshd: runs as $ME without root, listens on loopback only and is
# reached from the u26 through the reverse tunnel.
ListenAddress 127.0.0.1:{{ mac_sshd_port }}
HostKey $D/ssh_host_ed25519_key
PidFile $D/sshd.pid
AuthorizedKeysFile $D/authorized_keys
AllowUsers $ME
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
# PAM needs root; without it sshd can still log in as the user running it.
UsePAM no
StrictModes yes
ClientAliveInterval 15
ClientAliveCountMax 3
Subsystem sftp /usr/libexec/sftp-server
EOF
/usr/sbin/sshd -t -f "$D/sshd_config"

put "$D/watchdog.sh" 755 <<'WATCHDOG'
{{ lookup('ansible.builtin.template', 'mac-watchdog.sh.j2') }}
WATCHDOG

# cron: every minute plus at boot. Only touch the crontab when it needs changing.
current=$(crontab -l 2>/dev/null || true)
wanted=$(
  printf '%s\n' "$current" | grep -v '# mac-link$' | sed '/^$/d' || true
  echo "* * * * * \"$D/watchdog.sh\" # mac-link"
  echo "@reboot sleep 30 && \"$D/watchdog.sh\" # mac-link"
)
if [ "$wanted" != "$current" ]; then
  printf '%s\n' "$wanted" | crontab -
  CHANGED="$CHANGED crontab"
fi

kill_from() { if [ -f "$1" ]; then kill "$(cat "$1")" 2>/dev/null || true; fi; }
if changed sshd_config || changed ssh_host_ed25519_key || changed authorized_keys \
   || changed watchdog.sh || changed tunnel_key || changed known_hosts; then
  # Detached and delayed: when run from the u26 over the tunnel, this script
  # must return before the tunnel it travels through is restarted.
  nohup /bin/bash -c "sleep 3
    $(declare -f kill_from)
    kill_from '$D/sshd.pid'; kill_from '$D/tunnel.pid'; sleep 1
    '$D/watchdog.sh'" >/dev/null 2>&1 &
else
  "$D/watchdog.sh"
fi

if [ -n "$CHANGED" ]; then echo "changed:$CHANGED"; else echo "unchanged"; fi
if ! ifconfig | grep -q 'inet {{ tb_subnet.split('.')[:3] | join('.') }}\.'; then
  echo "note: no {{ tb_subnet }} address yet -- is the Thunderbolt cable in and Thunderbolt Bridge on DHCP?"
fi
echo "Mac side ready. From the u26: ssh mac   (allow up to a minute for the tunnel)"
