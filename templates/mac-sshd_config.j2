# Managed by Ansible (mac-link). User-level sshd: runs as {{ ansible_user_id }} without root,
# listens on loopback only and is reached from the u26 through the reverse tunnel.
ListenAddress 127.0.0.1:{{ mac_sshd_port }}
HostKey {{ d }}/ssh_host_ed25519_key
PidFile {{ d }}/sshd.pid
AuthorizedKeysFile {{ d }}/authorized_keys
AllowUsers {{ ansible_user_id }}
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
# PAM needs root; without it sshd can still log in as the user running it.
UsePAM no
StrictModes yes
ClientAliveInterval 15
ClientAliveCountMax 3
Subsystem sftp /usr/libexec/sftp-server
